# Aplicación
NODE_ENV=development
HOST=127.0.0.1
PORT=3200
HELPDESK_PUBLIC_URL=http://localhost:3200
CORS_ORIGINS=http://localhost:3200

# SQL Server
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=GLOBAL_HELPDESK
DB_USER=sa
DB_PASSWORD=ChangeMe_OnlyLocal_2026!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_AUTO_CREATE=true
DB_CONNECTION_TIMEOUT_MS=30000

# Docker Compose usa esta contraseña para SQL Server y para la aplicación.
MSSQL_SA_PASSWORD=ChangeMe_OnlyLocal_2026!
MSSQL_PORT=1433

# Sesiones y seguridad
HELPDESK_SESSION_TTL_HOURS=12
HELPDESK_MAX_LOGIN_FAILURES=5
HELPDESK_LOCK_MINUTES=15
HELPDESK_STATE_DIR=./storage/state
HELPDESK_TICKET_METADATA_FILE=./storage/state/ticket-metadata.json

# Adjuntos locales (R2 es opcional)
HELPDESK_UPLOAD_TEMP_DIR=./storage/tmp
HELPDESK_UPLOAD_DIR=./storage/uploads
HELPDESK_ATTACHMENT_RETENTION_DAYS=60
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_SIGNED_URL_SECONDS=900

# Correo opcional. Sin estas variables el sistema funciona, pero no envía correos.
HELPDESK_MASTER_EMAILS=
HELPDESK_EMAIL_LOGO_PATH=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
